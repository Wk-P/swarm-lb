# swarm-lb 环境参数模板。每个环境复制一份：  cp envs/example.env envs/<环境名>.env  （如 lab = 本地 192.x 集群）
# envs/*.env 不进 git（example.env 除外）；deploy 时同步到 manager 的 $REMOTE_DIR/.env（chmod 600）。

# ---- 节点：ssh 别名（~/.ssh/config 中的 Host）、IP、eth0 的 MAC
# IP 由路由器按 MAC 做 DHCP 地址保留，换设备/网卡时要同步改路由器（见 README「节点 IP 与路由器」）
MANAGER_SSH=manager
MANAGER_IP=192.0.2.100
MANAGER_MAC=00:00:00:00:00:00
WORKER1_SSH=worker-1
WORKER1_IP=192.0.2.150
WORKER1_MAC=00:00:00:00:00:01
WORKER2_SSH=worker-2
WORKER2_IP=192.0.2.151
WORKER2_MAC=00:00:00:00:00:02
WORKER3_SSH=worker-3
WORKER3_IP=192.0.2.152
WORKER3_MAC=00:00:00:00:00:03
# 网关（做 DHCP 地址保留的路由器）
GATEWAY_IP=192.0.2.1

# ---- 节点上的账号与路径
REMOTE_USER=pi
# 本仓库在 manager 上的部署目录
REMOTE_DIR=/home/pi/swarm-lb
# 各节点上监控 agent 的目录
AGENT_DIR=/home/pi/swarm-lb-agent
# 8080 用的 gurobi license
GRB_LICENSE_FILE=/home/pi/gurobi.lic

# ---- manager 程序 SSH 到 worker 读资源用（host/manager/worker_manager.py / swarm/info.py）
NODE_SSH_USER=pi
NODE_SSH_PASSWORD=change-me

# ---- docker / stack
DOCKER_IMAGE=yourname/collect_data_app:v8
STACK_NAME=collect_data_stack
# stack-start.sh、rebuild-swarm.sh 用：本仓库的线上 stack（镜像按 digest 锁定）
STACK_COMPOSE=/home/pi/swarm-lb/image/stack/collect_data_stack.yml
# build-image.sh 用：本仓库的 worker 源码
DOCKER_BUILD_DIR=/home/pi/swarm-lb/image/worker-app

# ---- 端口
OPS_PORT=5000
AGENT_PORT=9100
