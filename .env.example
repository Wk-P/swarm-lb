# swarm-lb 本机部署参数。复制为 .env 并填入真实值：  cp .env.example .env
# .env 已在 .gitignore 中，不进 git；deploy 脚本会把它同步到 manager 的 $REMOTE_DIR/.env（chmod 600）。

# ---- 节点：ssh 别名（~/.ssh/config 中的 Host）和 IP
MANAGER_SSH=manager
MANAGER_IP=192.0.2.100
WORKER1_SSH=worker-1
WORKER1_IP=192.0.2.150
WORKER2_SSH=worker-2
WORKER2_IP=192.0.2.151
WORKER3_SSH=worker-3
WORKER3_IP=192.0.2.152

# ---- 节点上的账号与路径
REMOTE_USER=pi
# 本仓库在 manager 上的部署目录
REMOTE_DIR=/home/pi/swarm-lb
# 各节点上监控 agent 的目录
AGENT_DIR=/home/pi/swarm-lb-agent
# 8080 用的 gurobi license
GRB_LICENSE_FILE=/home/pi/gurobi.lic

# ---- manager 程序 SSH 到 worker 读资源用（manager_objects.py / docker_utils/utils.py）
NODE_SSH_USER=pi
NODE_SSH_PASSWORD=change-me

# ---- docker / stack
DOCKER_IMAGE=yourname/collect_data_app:v8
STACK_NAME=collect_data_stack
# start_stack.sh 用
STACK_COMPOSE=/home/pi/appv8/stack-config/docker-compose.yaml
# rebuild-swarm.sh 用
REBUILD_COMPOSE=/home/pi/apps/docker/configures/docker-compose.yml
# build.sh 用
DOCKER_BUILD_DIR=/home/pi/appv8/docker

# ---- 端口
OPS_PORT=5000
AGENT_PORT=9100
