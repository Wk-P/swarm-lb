# 由 swarm-lb 仓库管理：ops/cluster/systemd/collect_8084.service  (uv run ops/local/deploy_host.py 安装)
# 模板：@变量名@ 占位符由 ops/local/common.py 的 render 用环境参数替换
[Unit]
Description=swarm-lb 8084 XGB collector handle_hdd_v2 rr [soar009]
After=network.target

[Service]
Type=simple

User=@REMOTE_USER@
Group=@REMOTE_USER@
WorkingDirectory=@REMOTE_DIR@/host/manager/

EnvironmentFile=-@REMOTE_DIR@/.env
Environment=PYTHONUNBUFFERED=1

ExecStart=@REMOTE_DIR@/.venv/bin/python @REMOTE_DIR@/host/manager/collector_hdd_tier.py

Restart=no

[Install]
WantedBy=multi-user.target
