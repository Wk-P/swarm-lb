# 由 swarm-lb 仓库管理：deploy/systemd/swarm-lb-ops.service  (deploy/deploy-manager.sh 安装)
[Unit]
Description=swarm-lb ops UI (:5000) [ours]
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/swarm-lb/ops/
Environment=PYTHONUNBUFFERED=1
Environment=OPS_PORT=5000
ExecStart=/home/pi/swarm-lb/.venv/bin/python /home/pi/swarm-lb/ops/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
