# 由 swarm-lb 仓库管理：deploy/systemd/collect_8080.service  (deploy/deploy-manager.sh 安装)
# 模板：@变量名@ 占位符由 deploy/lib.sh 的 render 用 .env 的值替换
[Unit]
Description=swarm-lb 8080 manager_hmsw [ours]
After=network.target

[Service]
Type=simple

User=@REMOTE_USER@
Group=@REMOTE_USER@
WorkingDirectory=@REMOTE_DIR@/manager/

EnvironmentFile=-@REMOTE_DIR@/.env
Environment=PYTHONUNBUFFERED=1
Environment=RGB_LICENSE_FILE=@GRB_LICENSE_FILE@
Environment=GRB_LICENSE_FILE=@GRB_LICENSE_FILE@
ExecStart=@REMOTE_DIR@/.venv/bin/python @REMOTE_DIR@/manager/manager_hmsw.py

Restart=no

[Install]
WantedBy=multi-user.target
